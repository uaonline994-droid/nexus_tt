rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // NEXUS Profile Document (Open read and write for live sync)
    match /nexus_profile/{profileId} {
      allow read, write: if true;
    }

    // Default safety fallback
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
