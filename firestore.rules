rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: Checks if user is authenticated and verified as Master Admin
    function isMasterAdmin() {
      return request.auth != null && 
             request.auth.token.email == "a60840397@gmail.com";
    }

    // Helper: Checks if user is authenticated
    function isSignedIn() {
      return request.auth != null;
    }

    // Public NEXUS Profile: Anyone can view, only Master Admin can write
    match /nexus_profile/{profileId} {
      allow read: if true;
      allow write: if isMasterAdmin();
    }

    // Security Incidents / Logs: Anyone can create, Master Admin full access
    match /security_incidents/{incidentId} {
      allow read: if isMasterAdmin();
      allow create: if true;
      allow update, delete: if isMasterAdmin();
    }

    match /nexus_security_logs/{logId} {
      allow read: if isMasterAdmin();
      allow create: if true;
      allow update, delete: if isMasterAdmin();
    }

    // Moderation & Banned List: Anyone can read status, only Master Admin can manage bans
    match /moderation/{docId} {
      allow read: if true;
      allow write: if isMasterAdmin();
    }

    // Real-Time Chat Messages: Anyone can read & create, only Master Admin can update/delete
    match /nexus_chat_messages/{messageId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isMasterAdmin();
    }

    // User Registration Profiles: Anyone can read profiles, users can create & update their profile
    match /nexus_user_profiles/{userId} {
      allow read: if true;
      allow create, update: if true;
      allow delete: if isMasterAdmin();
    }

    // Chat Settings & Web Room Settings: Anyone can read, only Master Admin can update
    match /nexus_chat_settings/{docId} {
      allow read: if true;
      allow write: if isMasterAdmin();
    }

    // Web Rooms & Peer Signaling
    match /nexus_rooms/{roomId}/peers/{peerId} {
      allow read, write: if true;
    }

    match /nexus_rooms/{roomId}/signals/{toPeerId}/{fromPeerId} {
      allow read, write: if true;
    }

    // Fallback: Default safe read & write
    match /{document=**} {
      allow read: if true;
      allow write: if true;
    }
  }
}

